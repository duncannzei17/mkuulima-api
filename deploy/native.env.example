APP_NAME=FarmOS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://__FARMOS_DOMAIN__
FRONTEND_URL=https://__FARMOS_DOMAIN__
CORS_ALLOWED_ORIGINS=https://__FARMOS_DOMAIN__
TRUSTED_PROXIES=127.0.0.1
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=farmos_master
DB_USERNAME=farmos
DB_PASSWORD=
TENANCY_DRIVER=schema
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=5432
TENANT_DB_DATABASE=farmos_master
TENANT_DB_USERNAME=farmos
TENANT_DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_PREFIX=farmos_
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_HORIZON_DB=4
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=FarmOS

KAFKA_ENABLED=false
