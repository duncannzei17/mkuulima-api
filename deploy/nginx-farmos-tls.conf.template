# The API listens only on loopback. The public vhost serves the SPA and proxies /api.
server {
    listen 127.0.0.1:8006;
    server_name _;
    root /var/www/mkuulima/backend/public;
    index index.php;
    client_max_body_size 20m;

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location = /index.php {
        internal;
        include /etc/nginx/fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/mkuulima/backend/public/index.php;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_read_timeout 60s;
    }

    location ~ /\. {
        deny all;
    }

    location ~ \.php$ {
        return 404;
    }
}

# Public HTTPS host for FarmOS. The existing sites keep their own certificates.
server {
    listen 443 ssl;
    server_name __FARMOS_DOMAIN__ www.__FARMOS_DOMAIN__;
    ssl_certificate /etc/letsencrypt/live/__FARMOS_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__FARMOS_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /var/www/mkuulima/frontend/dist;
    index index.html;
    client_max_body_size 20m;

    if ($host = www.__FARMOS_DOMAIN__) {
        return 301 https://__FARMOS_DOMAIN__$request_uri;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
    add_header Strict-Transport-Security "max-age=86400" always;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8006;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /storage/ {
        alias /var/www/mkuulima/backend/storage/app/public/;
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ /\. {
        deny all;
    }

    location ~ \.php$ { return 404; }
}

server {
    listen 80;
    server_name __FARMOS_DOMAIN__ www.__FARMOS_DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 301 https://__FARMOS_DOMAIN__$request_uri;
    }
}
