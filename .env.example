APP_NAME="FarmOS API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3003
CORS_ALLOWED_ORIGINS=http://localhost:3003
CORS_MAX_AGE=600

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Weather API Configuration
OPENWEATHER_API_KEY=your_openweather_api_key_here
WEATHER_CACHE_DURATION=30

# Multi-tenant configuration
TENANCY_DRIVER=schema
TENANCY_AUTO_CREATE_TENANT_DATABASE=false
TENANCY_AUTO_DELETE_TENANT_DATABASE=false

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=farmos_master
DB_USERNAME=farmos
DB_PASSWORD=farmos_password

# Tenant Database Configuration
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=5432
TENANT_DB_DATABASE=farmos_master
TENANT_DB_USERNAME=farmos
TENANT_DB_PASSWORD=farmos_password

# Redis Configuration
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=farmos_redis_password
REDIS_PORT=6379

# Cache Configuration
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=false

# Request throttling
API_RATE_LIMIT_PER_MINUTE=300
API_GUEST_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
TOKEN_REFRESH_RATE_LIMIT_PER_MINUTE=30

# Broadcasting
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Kafka Configuration
KAFKA_BROKER_HOST=localhost
KAFKA_BROKER_PORT=9092
KAFKA_ENABLED=true

# Ecosystem Integration
ECOSYSTEM_PLATFORM=farmos
ECOSYSTEM_API_KEY=
VENMAS_API_URL=http://localhost:8001/api
SIKUMPYA_API_URL=http://localhost:8002/api
RENTIZEN_API_URL=http://localhost:8003/api
BMS_API_URL=http://localhost:8004/api

# File Storage
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@farmos.local"
MAIL_FROM_NAME="${APP_NAME}"

# SMS Configuration (for African markets)
SMS_DRIVER=africas_talking
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=

# M-Pesa Integration (Kenya)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENVIRONMENT=sandbox

# Weather API
OPENWEATHER_API_KEY=
WEATHER_LOCATION_DEFAULT="Nairobi,KE"

# Market Data API
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=

# JWT Configuration
JWT_SECRET=
JWT_TTL=1440

# Telescope (for development)
TELESCOPE_ENABLED=true

# Laravel Horizon (for queue management)
HORIZON_REDIS_CONNECTION=horizon
