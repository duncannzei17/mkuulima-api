APP_NAME="FarmOS API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://farm.example.com
FRONTEND_URL=https://farm.example.com
CORS_ALLOWED_ORIGINS=https://farm.example.com
TRUSTED_PROXIES=REMOTE_ADDR
CORS_MAX_AGE=600

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=farmos-db
DB_PORT=5432
DB_DATABASE=farmos_master
DB_USERNAME=farmos
POSTGRES_PASSWORD=
DB_PASSWORD=${POSTGRES_PASSWORD}

TENANCY_DRIVER=schema
TENANT_DB_HOST=farmos-db
TENANT_DB_PORT=5432
TENANT_DB_DATABASE=farmos_master
TENANT_DB_USERNAME=farmos
TENANT_DB_PASSWORD=${POSTGRES_PASSWORD}

REDIS_HOST=farmos-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CLIENT=phpredis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true

API_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
TOKEN_REFRESH_RATE_LIMIT_PER_MINUTE=30

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="FarmOS"

KAFKA_ENABLED=false
OPENWEATHER_API_KEY=
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
